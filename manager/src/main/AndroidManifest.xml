<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ================================================================
         【v1.4.6 修复 · 原版 Shizuku 无法给本应用授权】
         Shizuku 官方的 client 判定有**两个必要条件**（源码依据：
           · Shizuku/server BinderSender.ProcessObserver：只对 requestedPermissions
             含 moe.shizuku.manager.permission.API_V23 的包下发 binder；
           · Shizuku/manager AuthorizationManager.getApplications：要求 meta-data
             moe.shizuku.client.V3_SUPPORT=true **且** 申请了 API_V23 权限，
             否则该应用根本不出现在 Shizuku 的授权列表里）。
         本工程把 provider 以**源码**方式内联（rikka.shizuku.ShizukuProvider），
         因此丢掉了官方 provider AAR manifest 里的这两行声明，导致：
           · 原版 Shizuku 看不到本应用、也永远送不来 binder（只显示未授权）；
           · Shizuku.pingBinder() 恒为 false → 所有 shell 档位（挂起/卸载等）不可用。
         此处按官方 provider 库的 manifest 原样补齐。
         ================================================================ -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- MANAGER 权限：用 ${applicationId} 占位，使 main/manages 两个发行版
         各自声明自己的权限名（main=frb.axeron.manager.permission.MANAGER，
         manages=frb.axerond.manages.permission.MANAGER）。
         main 展开后与原硬编码值完全一致，不影响现有行为与签名。 -->
    <permission
        android:name="${applicationId}.permission.MANAGER"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.MANAGER" />
    <!-- Device Owner / Device Admin：非 root 下获取设备所有者高级权限 -->
    <uses-feature
        android:name="android.software.device_admin"
        android:required="false" />
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- ================================================================
         新权限路径：DP + WS（国产 ROM 砍掉 DO/PO 后的替代方案）

         DP = android.app.role.DEVICE_POLICY_MANAGEMENT（Role，能力容器）
         WS = android.permission.WRITE_SECURE_SETTINGS（能力钥匙）

         依据：AOSP PermissionController/res/xml/roles.xml 中
         <role name="android.app.role.DEVICE_POLICY_MANAGEMENT"> 绑定 73 个权限，
         其中已包含 WRITE_SECURE_SETTINGS 与 MANAGE_DEVICE_ADMINS。

         注意：这些是 signature|role 档权限，必须在 manifest 中声明，
         系统才会在「持有 Role 后重装/更新」时自动授予；不能靠 pm grant。
         ================================================================ -->
    <uses-permission
        android:name="android.permission.MANAGE_DEVICE_ADMINS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 【v1.6.4 关键修复】必须声明 MANAGE_PROFILE_AND_DEVICE_OWNERS。
         它是非 ADB 直连路径（[DpDoDirectActivation]）的**唯一放行判据**：
           - forceUpdateUserSetupComplete() / setDeviceOwner() 都要求
             hasCallingOrSelfPermission(MANAGE_PROFILE_AND_DEVICE_OWNERS)；
           - 而 checkSelfPermission 走 PermissionManagerServiceImpl#checkPermissionInternal
             → UidPermissionState.isPermissionGranted(name)，该方法要求
             `mPermissions.get(name) != null`。**未在 manifest 声明的权限根本不会
             进入 UidPermissionState 的权限表**，即使持有 Role 也恒返回 DENIED。
         这正是「DP_GRANT_OK 却始终报未获得 MAPDO」的根因。 -->
    <uses-permission
        android:name="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS"
        tools:ignore="ProtectedPermissions" />


    <application
        android:name="org.lsposed.lspatch.LSPApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:directBootAware="true"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AxManager"
        tools:ignore="HardcodedDebugMode"
        tools:targetApi="33">

        <activity
            android:name=".ui.AxActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="application/zip" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RequestPermissionActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="${applicationId}.intent.action.REQUEST_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.webui.WebUIActivity"
            android:autoRemoveFromRecents="true"
            android:documentLaunchMode="intoExisting"
            android:exported="true"
            android:theme="@style/Theme.AxManager.WebUI">
            <intent-filter>
                <action android:name="AxManager.WEB_UI" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Toast"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=":toast"
            android:theme="@style/Theme.Transparent.NoUI">
            <intent-filter>
                <action android:name="AxManager.TOAST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="frb.axeron.server.shell.ShellRequestHandlerActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="AxRuntime.REQUEST_BINDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CrashActivity"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:theme="@style/Theme.AxManager" />

        <!-- AI 安全分析整页界面（方案 A：安装/运行模块前拦截分析弹窗） -->
        <activity
            android:name=".ai.AIAnalysisActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AxManager" />

        <!-- v1.1.0 卸载回滚：恢复脚本预览 + 执行界面 -->
        <activity
            android:name=".ai.RestoreScriptPreviewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AxManager" />

        <receiver
            android:name="frb.axeron.server.shell.BinderRequestReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="AxRuntime.REQUEST_BINDER" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".AxManagerProvider"
            android:authorities="${applicationId}.server"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- Dhizuku 兼容 Daemon：Device Owner 授权 Provider（第三方 Dhizuku API app 自动连接） -->
        <provider
            android:name="frb.axeron.manager.dhizuku.AxManagerDhizukuProvider"
            android:authorities="${applicationId}.dhizuku_server.provider"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true" />
        <!-- Shizuku Binder 接收 Provider（Shizuku 授权链路） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!--
            【v1.4.6】Shizuku 客户端标记（与官方 provider 库的 manifest 一致）。
            Shizuku 管理端 AuthorizationManager 用它筛选「谁是 Shizuku 客户端」，
            缺失时本应用不会出现在 Shizuku 的授权列表里，永远拿不到 binder。
        -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".receiver.BootCompleteReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.MANAGER">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Owner 特权命令执行入口（app 进程内，uid 正确，可过 Dhizuku 校验） -->
        <receiver
            android:name=".owner.DpmCommandReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="frb.axeron.manager.action.EXEC_DPM" />
            </intent-filter>
        </receiver>

        <!-- Device Owner 特权命令执行入口（Service 版，替代广播，规避部分设备的广播 skip 限制） -->
        <service
            android:name=".owner.DpmCommandService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="frb.axeron.manager.action.EXEC_DPM" />
            </intent-filter>
        </service>

        <!-- 无 UI 进程唤醒入口：axeron-dpm 脚本在 startservice 前先 am start 本 Activity，
             让 manager 进程进入前台可见状态，绕开 Android 8+ 后台启动限制（无闪屏）。 -->
        <activity
            android:name=".owner.DpmWakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="frb.axeron.manager.wake"
            android:theme="@style/Theme.Transparent.NoUI"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="frb.axeron.manager.action.EXEC_DPM_WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Device Owner 激活三组件（Dhizuku 机制整合） -->
        <receiver
            android:name=".owner.DeviceOwnerReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_owner_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.PROFILE_OWNER_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Dhizuku 兼容：接收第三方 app 的授权请求弹窗 -->
        <activity
            android:name="frb.axeron.manager.dhizuku.RequestDhizukuPermissionActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="${applicationId}.action.REQUEST_DHIZUKU_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".owner.ProvisioningActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".owner.FinalizeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".features.quicksettings.AxeronTileService"
            android:exported="true"
            android:icon="@drawable/ic_axeron"
            android:label="QuickAccess"
            android:permission="android.permission.BIND_QUICK_SETTINGS">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- ================================================================
             【v1.4.9 闪退修复 · ForegroundServiceDidNotStopInTimeException】
             真实崩溃日志（Android 15，PID 30069）：
               RemoteServiceException$ForegroundServiceDidNotStopInTimeException:
                 A foreground service of type dataSync did not stop within its timeout:
                 ComponentInfo{frb.axeron.manager/...features.keepalive.KeepAliveService}
               ForegroundServiceStartNotAllowedException:
                 Time limit already exhausted for foreground service type dataSync
             根因：Android 14+（SDK 34）对 foregroundServiceType="dataSync" 施加
             **累计 6 小时/天** 的硬配额。保活服务是常驻的，配额一旦耗尽：
               · startForeground() 抛 ForegroundServiceStartNotAllowedException；
               · 进程未按时 stopForeground() 再抛 DidNotStopInTimeException。
             崩溃后 AxActivity.onResume 的「自恢复」又把它拉起来 → 无限崩溃循环。
             修法：这三个服务都不做真正的数据同步，语义本就是「本应用自身持续运行」，
             因此改用 specialUse（无时长配额，需在 manifest 声明 SOURCE/SUBTYPE）。
             ================================================================ -->
        <service
            android:name=".features.keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep the app process alive in the background so modules stay usable" />
        </service>
        <service
            android:name=".features.runtime.RuntimeModuleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="supervise long-running runtime module processes and their sensors" />
        </service>
        <service
            android:name=".features.bootstart.BootStartService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="re-establish adb connection right after boot" />
        </service>

        <!-- LSPatch (AXMD) 注入引擎组件 -->
        <service
            android:name="org.lsposed.lspatch.manager.ModuleService"
            android:exported="true" />

        <service
            android:name="org.lsposed.lspatch.service.LogCollectorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous log monitoring for patched apps and the Xposed framework" />
        </service>

        <!-- 将 patched APK 交给其他 installer 安装时用的 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.patched"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/patched_apk_paths" />
        </provider>
    </application>

</manifest>