#!/system/bin/sh
#
# axoverlay —— 模块核心文件 Overlay CLI（AxManagerD）
#
# 用途：运行时模块通过本命令读写自己的 overlay 覆盖层，
#       覆盖层内容优先于 App 的 assets 原始文件。
#
# 目录约定（均位于 shell 数据目录）：
#   ${AXERON_ROOT}/perm/pending/<id>.json   模块申请
#   ${AXERON_ROOT}/perm/granted/<id>.json   用户授权结果
#   ${AXERON_ROOT}/perm/global.json         全局开关 + 免责确认
#   ${AXERON_ROOT}/runtime_plugins/<id>/overlay/   运行时模块覆盖层
#   ${AXERON_ROOT}/plugins/<id>/overlay/           Shell 模块覆盖层
#
# 子命令：
#   info                      输出能力/授权/路径信息
#   check                     检查是否已授权（exit 0=已授权）
#   request --reason="..."    发起授权申请（写 pending）
#   put <relpath>             从 stdin 写覆盖文件
#   get <relpath>             读覆盖文件到 stdout
#   rm  <relpath>             删除覆盖文件
#   ls  [dir]                 列出覆盖层内容
#   clear                     清空本模块覆盖层
#
# 模块 id 解析顺序：环境变量 AX_MODULE_ID > $PWD > $0，
# 且同时支持 runtime_plugins/<id>（运行时模块）与 plugins/<id>（Shell 模块）。
#
# 【v1.9.2 第三期】能力声明门禁：
#   模块必须在自己的 module.prop 里声明 `capabilities=overlay`，
#   才会在**安装过程中**由 App 弹窗向用户请求授权；
#   未声明的模块一律不授权（is_granted 直接失败，写入类子命令全部拒绝）。
#

set -u

# ---------------------------------------------------------------------------
# 环境与路径
# ---------------------------------------------------------------------------

# 兼容 Root / Shizuku 两种模式（与 App 侧 PathHelper.getWorkingPath 保持一致）。
#
# 【v1.9.1 修复】原判定只看「目录是否存在」：
#     if [ -d "/data/user_de/0/android/axeron" ]; then ROOT_DE else SHELL_DE fi
# 若该目录只是残留空壳（先前 root 模式安装留下的空目录），脚本会写 ROOT_DE，
# 而 App（非 root）读 SHELL_DE →「模块写的 pending 与 App 扫的目录不是同一个
# → 弹窗永远不出现」。改为只认「确实装了 axeron 内容」的根目录。
if [ -d "/data/user_de/0/android/axeron/perm" ] \
    || [ -d "/data/user_de/0/android/axeron/plugins" ] \
    || [ -d "/data/user_de/0/android/axeron/runtime_plugins" ]; then
    AXERON_ROOT="/data/user_de/0/android/axeron"
else
    AXERON_ROOT="/data/user_de/0/com.android.shell/axeron"
fi

PERM_DIR="${AXERON_ROOT}/perm"
PENDING_DIR="${PERM_DIR}/pending"
GRANTED_DIR="${PERM_DIR}/granted"
GLOBAL_JSON="${PERM_DIR}/global.json"
RUNTIME_ROOT="${AXERON_ROOT}/runtime_plugins"
# Shell 模块目录（第二期：授权页分「Shell 模块 / 运行时模块」，
# 两者模块目录不同，overlay 也各自落在自己目录下，必须都支持）。
SHELL_ROOT="${AXERON_ROOT}/plugins"

# ---------------------------------------------------------------------------
# 工具函数
# ---------------------------------------------------------------------------

die() {
    echo "axoverlay: $1" >&2
    exit "${2:-1}"
}

usage() {
    cat >&2 <<'EOF'
用法: axoverlay <子命令> [参数]

  info                      输出能力/授权/路径信息
  check                     检查是否已授权 (exit 0=已授权)
  request --reason="..."    发起授权申请
  put <relpath>             从 stdin 写入覆盖文件
  get <relpath>             读取覆盖文件到 stdout
  rm  <relpath>             删除覆盖文件
  ls  [dir]                 列出覆盖层内容
  clear                     清空本模块覆盖层
  priority [整数]           查询/设置覆盖冲突优先级（大者胜）
EOF
    exit 2
}

# 解析模块 id。支持两类模块目录：
#   runtime_plugins/<id>   （运行时模块）
#   plugins/<id>           （Shell 模块）
# 结果写入全局变量：MODULE_ID 与该模块的 REAL_ROOT（用于定位 overlay 目录）。
# 优先级：AX_MODULE_ID 环境变量 > $PWD 推断 > $0 推断。
MODULE_ID=""
REAL_ROOT=""

try_root() {
    # $1=候选根目录  $2=待匹配路径
    case "$2" in
        "$1"/*)
            rest="${2#"$1"/}"
            MODULE_ID="${rest%%/*}"
            REAL_ROOT="$1"
            return 0
            ;;
    esac
    return 1
}

resolve_module_id() {
    if [ -n "${AX_MODULE_ID:-}" ]; then
        MODULE_ID="${AX_MODULE_ID}"
        # 环境变量只给了 id；按目录实际存在情况挑选根。
        if [ -d "${SHELL_ROOT}/${MODULE_ID}" ] && [ ! -d "${RUNTIME_ROOT}/${MODULE_ID}" ]; then
            REAL_ROOT="${SHELL_ROOT}"
        else
            REAL_ROOT="${RUNTIME_ROOT}"
        fi
        return 0
    fi
    # 从当前工作目录推断
    try_root "${RUNTIME_ROOT}" "${PWD:-}" && return 0
    try_root "${SHELL_ROOT}" "${PWD:-}" && return 0
    # 回退：调用方脚本所在目录
    try_root "${RUNTIME_ROOT}" "${0:-}" && return 0
    try_root "${SHELL_ROOT}" "${0:-}" && return 0
    return 1
}

resolve_module_id || die "无法确定模块 id（请设置 AX_MODULE_ID 或在模块目录内执行）"

OVERLAY_DIR="${REAL_ROOT}/${MODULE_ID}/overlay"
PENDING_JSON="${PENDING_DIR}/${MODULE_ID}.json"
GRANTED_JSON="${GRANTED_DIR}/${MODULE_ID}.json"

# JSON 里取字符串字段（无 python/jq 依赖，用 sed 粗解析）。
json_get() {
    # $1=file $2=key
    [ -f "$1" ] || return 1
    sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n1
}

# JSON 里取布尔字段。文件缺失、字段缺失、值非 true 一律输出 false。
#
# 【v1.9.1 关键 BUG 修复 · toybox sed 不支持 BRE 的 `\|` 交替】
# 原实现：sed -n 's/.*"key"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p'
# 真机实测（vivo A13，/system/bin/sed 为 toybox，"This is not GNU sed version 9.0"）：
#   - 含 `\|` 交替的 BRE 表达式 → **零输出**（busybox sed 同样如此）；
#   - 于是 global_enabled()/global_disclaimer() 恒为 false →
#     is_granted() 恒 false →
#     **模块侧 `axoverlay check/put/rm/clear` 全部永久失败**，
#     即便 App 里总开关已开、该模块也已授权。
# 修复方式：只匹配 `true`，匹配不到即 false（语义完全等价，且可移植）。
json_get_bool() {
    if [ ! -f "$1" ]; then
        echo "false"
        return 0
    fi
    local v
    v="$(sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\(true\).*/\1/p' "$1" 2>/dev/null | head -n1)"
    if [ "${v}" = "true" ]; then
        echo "true"
    else
        echo "false"
    fi
}

# 读取全局开关（文件不存在视为关闭）。
global_enabled() {
    [ "$(json_get_bool "${GLOBAL_JSON}" enabled)" = "true" ] && echo "true" || echo "false"
}

global_disclaimer() {
    [ "$(json_get_bool "${GLOBAL_JSON}" disclaimerAccepted)" = "true" ] && echo "true" || echo "false"
}

# ---------------------------------------------------------------------------
# 能力声明判定（第三期：安装期声明 → 安装时弹窗授权）
# ---------------------------------------------------------------------------

# 本模块的 module.prop 路径（模块目录下，与授权记录 <id>.json 同源）。
module_prop_path() {
    echo "${REAL_ROOT}/${MODULE_ID}/module.prop"
}

# 本模块是否在 module.prop 里声明了 capabilities=overlay。
#
# 【v1.9.2 第三期】需求：模块必须先在 module.prop 里声明能力，安装过程中才向
# 用户弹窗请求授权；**未声明的模块一律不授权**。
# 这是模块侧（shell）的最后一层卡点：即便 App 侧的判定被绕过，
# 未声明的模块也无法通过 `axoverlay put/rm/clear/priority` 写入覆盖层。
#
# 实现注意（踩坑记录）：
#   - toybox sed 不支持 BRE 的 `\|` 交替（v1.9.1 已踩），因此这里先按行取出
#     capabilities= 的值，再用 IFS 拆分逐个比对，绝不做多值交替匹配；
#   - 声明值可能是 `overlay`，也可能是 `overlay,notify` 这类逗号/分号/竖线列表，
#     大小写不敏感。
declares_overlay() {
    local prop caps
    prop="$(module_prop_path)"
    if [ ! -f "${prop}" ]; then
        return 1
    fi
    # 取最后一个 capabilities= 的值（后者覆盖前者），去掉首尾空白与 CR。
    caps="$(sed -n 's/^[[:space:]]*capabilities[[:space:]]*=[[:space:]]*//p' "${prop}" 2>/dev/null | tail -n1 | tr -d ' \r')"
    if [ -z "${caps}" ]; then
        return 1
    fi
    local oldifs one
    oldifs="${IFS}"
    IFS=',;|'
    for one in ${caps}; do
        case "$(printf '%s' "${one}" | tr 'A-Z' 'a-z')" in
            overlay)
                IFS="${oldifs}"
                return 0
                ;;
        esac
    done
    IFS="${oldifs}"
    return 1
}

# 授权判定：返回 0 表示允许写入。
is_granted() {
    # 【v1.9.2 第三期】未在 module.prop 声明 capabilities=overlay 的模块一律不授权。
    declares_overlay || return 1
    [ "$(global_enabled)" = "true" ] || return 1
    [ "$(global_disclaimer)" = "true" ] || return 1
    [ -f "${GRANTED_JSON}" ] || return 1
    local mode
    mode="$(json_get "${GRANTED_JSON}" mode)"
    local expires
    expires="$(sed -n 's/.*"expiresAt"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "${GRANTED_JSON}" | head -n1)"
    [ -z "${expires}" ] && expires=0
    if [ "${mode}" = "once" ] && [ "${expires}" != "0" ]; then
        now="$(date +%s 2>/dev/null || echo 0)"
        if [ "${now}" -ge "${expires}" ] 2>/dev/null; then
            return 1
        fi
    fi
    return 0
}

# 规范化相对路径：拒绝绝对路径与 .. 穿越。
# 注意：必须在当前 shell 内调用（不用 $(...)），否则 die 的 exit 只退出子 shell。
# 调用后结果写入全局变量 REL。
normalize_rel() {
    REL="$1"
    case "${REL}" in
        "") die "缺少路径参数" ;;
        /*) die "路径必须是相对于 overlay 根目录的相对路径" ;;
    esac
    case "${REL}" in
        *..*) die "路径不允许包含 '..'" ;;
    esac
    return 0
}

ensure_dirs() {
    mkdir -p "${PENDING_DIR}" "${GRANTED_DIR}" 2>/dev/null
}

SUB="${1:-}"
[ -n "${SUB}" ] || usage
shift 2>/dev/null || true

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------

case "${SUB}" in

info)
    echo "moduleId   : ${MODULE_ID}"
    echo "axeronRoot : ${AXERON_ROOT}"
    echo "overlayDir : ${OVERLAY_DIR}"
    echo "globalOn   : $(global_enabled)"
    echo "disclaimer : $(global_disclaimer)"
    # 第三期：是否在 module.prop 声明了 capabilities=overlay（未声明一律不授权）
    echo "declares   : $(declares_overlay && echo true || echo false)"
    echo "granted    : $(is_granted && echo true || echo false)"
    if [ -f "${GRANTED_JSON}" ]; then
        echo "grantMode  : $(json_get "${GRANTED_JSON}" mode)"
        echo "grantReason: $(json_get "${GRANTED_JSON}" reason)"
    fi
    if [ -f "${OVERLAY_DIR}/priority" ]; then
        echo "priority   : $(cat "${OVERLAY_DIR}/priority" 2>/dev/null)"
    else
        echo "priority   : 0"
    fi
    if [ -d "${OVERLAY_DIR}" ]; then
        cnt="$(find "${OVERLAY_DIR}" -type f 2>/dev/null | wc -l | tr -d ' ')"
        size="$(du -sk "${OVERLAY_DIR}" 2>/dev/null | cut -f1)"
        echo "files      : ${cnt:-0}"
        echo "sizeKB     : ${size:-0}"
    else
        echo "files      : 0"
        echo "sizeKB     : 0"
    fi
    ;;

check)
    if is_granted; then
        echo "granted"
        exit 0
    fi
    echo "denied" >&2
    exit 1
    ;;

request)
    REASON=""
    for arg in "$@"; do
        case "${arg}" in
            --reason=*) REASON="${arg#--reason=}" ;;
        esac
    done
    [ -n "${REASON}" ] || die "request 需要 --reason=\"...\""
    # 【v1.9.2 第三期】未声明 capabilities=overlay 的模块连申请都不受理：
    # 既不写入 pending（避免污染授权页的「已申请」列表），也不弹授权窗。
    declares_overlay || die "本模块未在 module.prop 声明 capabilities=overlay，无法申请核心文件修改权限"
    ensure_dirs
    now="$(date +%s 2>/dev/null || echo 0)"
    # 转义双引号，避免破坏 JSON。
    esc_reason="$(printf '%s' "${REASON}" | sed 's/"/\\"/g')"
    # 真机实测：本机 /system/bin/sh(mksh) 下 heredoc 会因无法创建临时文件而静默失败
    # （写出 0 字节文件）→ App 扫不到 pending → 不弹窗。改用 base64 单行管道。
    JSON="{\"id\":\"${MODULE_ID}\",\"reason\":\"${esc_reason}\",\"requestedAt\":${now},\"requestedCaps\":[\"assets_read\",\"assets_write\"]}"
    B64="$(printf '%s' "${JSON}" | base64 -w0 2>/dev/null || printf '%s' "${JSON}" | base64)"
    printf '%s' "${B64}" | base64 -d > "${PENDING_JSON}"
    chmod 644 "${PENDING_JSON}" 2>/dev/null
    echo "requested"
    ;;

put)
    normalize_rel "${1:-}"
    is_granted || die "未授权：请在设置中开启「允许模块修改核心文件」并授权本模块"
    DST="${OVERLAY_DIR}/${REL}"
    mkdir -p "$(dirname "${DST}")" || die "无法创建目录: $(dirname "${DST}")"
    cat > "${DST}" || die "写入失败: ${DST}"
    chmod 644 "${DST}" 2>/dev/null
    echo "ok ${REL}"
    ;;

get)
    normalize_rel "${1:-}"
    SRC="${OVERLAY_DIR}/${REL}"
    [ -f "${SRC}" ] || die "无覆盖: ${REL}" 1
    cat "${SRC}"
    ;;

rm)
    normalize_rel "${1:-}"
    is_granted || die "未授权：无法删除覆盖文件"
    SRC="${OVERLAY_DIR}/${REL}"
    [ -e "${SRC}" ] || die "不存在: ${REL}" 1
    rm -f "${SRC}"
    # 清理空目录（不触碰 overlay 根）
    d="$(dirname "${SRC}")"
    while [ "${d}" != "${OVERLAY_DIR}" ] && [ "${d}" != "/" ]; do
        rmdir "${d}" 2>/dev/null || break
        d="$(dirname "${d}")"
    done
    echo "removed ${REL}"
    ;;

ls)
    DIR="${1:-}"
    [ -d "${OVERLAY_DIR}" ] || exit 0
    if [ -n "${DIR}" ]; then
        find "${OVERLAY_DIR}/${DIR}" -type f 2>/dev/null | sed "s|^${OVERLAY_DIR}/||"
    else
        find "${OVERLAY_DIR}" -type f 2>/dev/null | sed "s|^${OVERLAY_DIR}/||"
    fi
    ;;

clear)
    is_granted || die "未授权：无法清空覆盖层"
    [ -d "${OVERLAY_DIR}" ] || { echo "cleared"; exit 0; }
    # 只删除 overlay/<id>/ 下的内容，绝不动 axeron 根目录。
    find "${OVERLAY_DIR}" -mindepth 1 -delete 2>/dev/null
    echo "cleared"
    ;;

priority)
    # 设置/查询覆盖冲突优先级（第二期）。
    # 多个模块覆盖同一文件时，priority 大者胜；相同则按模块目录名升序。
    VALUE="${1:-}"
    if [ -z "${VALUE}" ]; then
        if [ -f "${OVERLAY_DIR}/priority" ]; then
            cat "${OVERLAY_DIR}/priority"
        else
            echo "0"
        fi
        exit 0
    fi
    is_granted || die "未授权：无法设置优先级"
    case "${VALUE}" in
        *[!0-9-]*) die "priority 必须是整数，收到：${VALUE}" ;;
    esac
    mkdir -p "${OVERLAY_DIR}" || die "无法创建 overlay 目录"
    printf '%s\n' "${VALUE}" > "${OVERLAY_DIR}/priority" || die "写入优先级失败"
    chmod 644 "${OVERLAY_DIR}/priority" 2>/dev/null
    echo "priority ${VALUE}"
    ;;

*)
    usage
    ;;
esac
